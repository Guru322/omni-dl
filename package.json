{
  "name": "media-download-api",
  "version": "1.0.0",
  "description": "Media downloader API (YouTube, Instagram, TikTok, X, ...) powered by yt-dlp + ffmpeg",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "postinstall": "node scripts/install-ytdlp.js"
  },
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0"
  }
}
