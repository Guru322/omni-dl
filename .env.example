# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on
# PORT=3000

# If set, every request must send header  x-api-key: <value>
# Leave empty to disable auth (private/local deployments).
# API_KEY=change-me

# ── yt-dlp ────────────────────────────────────────────────────────────────────
# Path to the yt-dlp binary (defaults to whatever is on $PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Cookies exported from your browser (Netscape format, e.g. via "Get cookies.txt")
# — unlocks age-restricted / logged-in / member content on any platform.
# COOKIES_FILE=/app/cookies.txt

# ── Downloads ─────────────────────────────────────────────────────────────────
# Max simultaneous yt-dlp+ffmpeg subprocesses (POST /api/download jobs). FIFO queue.
# MAX_CONCURRENT=3

# Auto-delete finished jobs' files after N minutes (0 = keep forever)
# CLEANUP_MINUTES=60

# ── CDN tunnel (/api/media, use when hosting on your own domain) ──────────────
# Your public origin — used to build absolute proxied URLs in /api/media listings.
# e.g. https://api.gurusensei.dev
# PUBLIC_BASE=

# Seconds before resolved CDN links are considered stale and re-extracted
# (signed links expire on the platform's side anyway; 300 = 5 min is a good default)
# LINK_TTL=300
